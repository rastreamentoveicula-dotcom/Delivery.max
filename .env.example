# =====================================================
# Delivery Max - Variáveis de ambiente
# =====================================================
# Copie este arquivo para `.env` no ambiente local e preencha os valores.
# Na Netlify, cadastre as mesmas variáveis em:
#   Site settings > Environment variables > Add a variable
# (elas são injetadas no momento do build)

# URL do projeto Supabase (Project Settings > API > Project URL)
VITE_SUPABASE_URL=https://seu-projeto.supabase.co

# Chave pública/anon do Supabase (Project Settings > API > anon public)
# Pode ser usada no frontend: ela respeita as políticas de RLS do banco.
VITE_SUPABASE_PUBLISHABLE_KEY=sua-chave-anon-publica
